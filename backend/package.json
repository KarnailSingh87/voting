    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^6.8.0",
    "helmet": "^7.0.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.0",
    "mongoose": "^8.5.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "pino": "^10.3.1",
