MONGO_URI=mongodb+srv://harshvardhan20051216:harshvardhan20051216@cluster0.snxrq5b.mongodb.net/voting?retryWrites=true&w=majority

# ── Server ──
PORT=5005
NODE_ENV=development
JWT_SECRET=dev_secret_change_in_production_256bit

# ── CORS (comma-separated allowed origins) ──
#    Frontend (voter) runs on :5173, Admin runs on :5174 in dev
