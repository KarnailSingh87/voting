# ═══════════════════════════════════════════════════
#  BACKEND  (.env.example)
# ═══════════════════════════════════════════════════

# ── Database ──
MONGO_URI=mongodb://localhost:27017/voting

# ── Server ──
PORT=5005
NODE_ENV=development
JWT_SECRET=dev_secret_change_in_production_256bit

# ── CORS (comma-separated allowed origins) ──
#    Frontend (voter) runs on :5173, Admin runs on :5174 in dev
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ── Frontend & Admin URLs ──
#    DEV   → Voter: http://localhost:5173  |  Admin: http://localhost:5174
#    PROD  → Voter: https://<app>.onrender.com/  |  Admin: https://<app>.onrender.com/admin

# ── Default Admin Credentials (for seeding) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456

# ══════════════════════════════════════════════════════
#  PRODUCTION overrides (uncomment for Render deploy)
# ══════════════════════════════════════════════════════
# MONGO_URI=<your-mongodb-atlas-connection-string>
# JWT_SECRET=<a-long-random-256-bit-secret>
# NODE_ENV=production
# CORS_ORIGIN=
