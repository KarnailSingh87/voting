# Backend .env.example
# Copy this file to `backend/.env` and fill in real values. DO NOT commit secrets.

# --------------------------
# Database
# --------------------------
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/<dbname>?retryWrites=true&w=majority

# --------------------------
# Server
# --------------------------
PORT=5005
NODE_ENV=development

# JWT (use a long, random string in production)
JWT_SECRET=change_this_to_a_strong_secret_32+_chars

# Frontend/Admin URLs (used for CORS/links)
FRONTEND_URL=https://your-voter-frontend.example.com
ADMIN_URL=https://your-admin-frontend.example.com
CORS_ORIGIN=https://your-voter-frontend.example.com,https://your-admin-frontend.example.com

# --------------------------
# Admin bootstrap credentials (dev only)
# --------------------------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@123456

# --------------------------
# Cloudinary (image uploads)
# --------------------------
CLOUDINARY_API_KEY=<cloudinary_api_key>
CLOUDINARY_SECRET_KEY=<cloudinary_secret_key>
CLOUDINARY_NAME=<cloudinary_cloud_name>

# --------------------------
# Email / SMTP (OTP delivery)
# --------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
# Optional: FROM address used to send emails
SMTP_FROM=no-reply@example.com

# --------------------------
# Blockchain / Smart contract
# --------------------------
# Provide either ALCHEMY_AMOY_RPC or SEPOLIA_RPC_URL (or your provider's RPC URL)
ALCHEMY_AMOY_RPC=https://eth-rpc.example.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID

# Deployed contract address (on the network you chose)
VOTING_CONTRACT_ADDRESS=0x<deployed_contract_address>

# Private key used by backend to submit write transactions (optional — keep secret)
# If not set, backend can still read contract state but cannot send transactions.
DEPLOYER_PRIVATE_KEY=0x<your_private_key_here>

# If you want to use only the on-chain contract and skip the local DB-backed PoW chain:
USE_LOCAL_BLOCKCHAIN=false

# --------------------------
# Optional / 3rd-party integrations
# --------------------------
# (Add only those you use; leave blank otherwise)
# Twilio / SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# WhatsApp / other messaging providers (example placeholders)
WHATSAPP_API_KEY=
WHATSAPP_SENDER=

# Any other secrets your deployment platform may require
# e.g., cloud provider credentials, monitoring keys, etc.

# --------------------------
# Notes
# --------------------------
# - Never paste real private keys or secrets into public repos or chat.
# - Use your hosting provider's secret management (Render, Heroku, AWS Secrets Manager, GitHub Secrets).
# - For local dev, you can use a .env file with these values, but rotate and secure keys for production.

