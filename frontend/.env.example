# Voter Frontend Environment Variables Template
# Copy this file to `frontend/.env` and update values. DO NOT commit actual secrets.

CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_secret_key
CLOUDINARY_NAME=your_cloudinary_cloud_name

VITE_BACKEND_URL=https://your-backend-api.example.com
VITE_SOCKET_URL=https://your-backend-api.example.com
VITE_RAZORPAY_KEY_ID=your_razorpay_key_id

# ── Blockchain Settings ──
VITE_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
VITE_ALCHEMY_RPC=https://rpc-amoy.polygon.technology
VITE_CHAIN_ID=80002
